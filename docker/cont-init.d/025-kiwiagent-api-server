#!/command/with-contenv sh
# shellcheck shell=sh
#
# kiwiagent SaaS 场景专用: 从环境变量把 hermes 的 config.yaml 补上几块 SaaS
# 必需字段, 而 hermes 上游本身不做 YAML 里的 ${VAR} env 展开:
#   1. platforms.api_server.{enabled, extra.key}   —— 让 gateway 能调 pod
#   2. model.{provider, base_url, api_key, default} —— 让 hermes 把推理走
#      集群内的 LiteLLM 而不是默认的 OpenRouter
#   3. plugins.enabled += platforms/smartbuddy + tts.provider=smartbuddy
#      —— hermes 升级为插件默认 opt-in 后, bundled 的 smartbuddy 平台插件
#      不再自动加载, 其 platform_hint (onboarding 接力) 和 TTS provider
#      (对话内语音切换) 随之失效; 这里显式启用以恢复原设计.
#
# 序号 025: 在 stage2 (01-hermes-setup seed) 和 02-reconcile-profiles 之后,
# 保证 config.yaml 已 seed 出来才做 patch. 幂等: 同 key/base_url 已经写入
# 就 no-op.
#
# 触发条件:
#   API_SERVER_KEY   -> 开 api_server (SaaS gateway 契约)
#   LITELLM_BASE_URL -> 把 model provider 指向 LiteLLM
# 都不设时脚本静默退出, 对 non-kiwiagent 场景零影响.
set -eu

HERMES_HOME="${HERMES_HOME:-/opt/data}"
CFG="$HERMES_HOME/config.yaml"

# 两个触发条件都没设 → 不是 SaaS pod, 立即返回
if [ -z "${API_SERVER_KEY:-}" ] && [ -z "${LITELLM_BASE_URL:-}" ]; then
    exit 0
fi

# config.yaml 一定要在 —— 依赖 01-hermes-setup 的 seed 逻辑
if [ ! -f "$CFG" ]; then
    echo "[025-kiwiagent] $CFG missing (seed 未运行?), 跳过" >&2
    exit 0
fi

exec s6-setuidgid hermes /opt/hermes/.venv/bin/python - <<'PY'
import os, sys, yaml, pathlib

cfg_path = pathlib.Path(os.environ.get("HERMES_HOME", "/opt/data")) / "config.yaml"
data = yaml.safe_load(cfg_path.read_text()) or {}
dirty = False

# ---------- 1) API server (gateway 调 pod 用) ----------
api_key = os.environ.get("API_SERVER_KEY")
if api_key:
    platforms = data.setdefault("platforms", {})
    api_server = platforms.setdefault("api_server", {})
    extra = api_server.setdefault("extra", {})
    if not (api_server.get("enabled") is True and extra.get("key") == api_key):
        api_server["enabled"] = True
        extra["key"] = api_key
        host = os.environ.get("API_SERVER_HOST")
        if host:
            extra.setdefault("host", host)
        dirty = True

# ---------- 2) LiteLLM 作为 model provider ----------
litellm_url = os.environ.get("LITELLM_BASE_URL")
if litellm_url:
    litellm_key = os.environ.get("LITELLM_API_KEY", "")
    default_model = os.environ.get("HERMES_DEFAULT_MODEL", "qwen-plus")
    # LiteLLM 是 OpenAI-compat, 需要 base_url 上追 /v1
    base = litellm_url.rstrip("/")
    if not base.endswith("/v1"):
        base = base + "/v1"

    model = data.setdefault("model", {})
    already = (
        model.get("provider") == "custom"
        and model.get("base_url") == base
        and model.get("api_key") == litellm_key
        and (model.get("default") == default_model or model.get("model") == default_model)
    )
    if not already:
        model["provider"] = "custom"
        model["base_url"] = base
        model["api_key"] = litellm_key
        # hermes 支持 "default" 或 "model" 两种 key 名, 都写以防
        model["default"] = default_model
        model["model"] = default_model
        dirty = True

# ---------- 3) SmartBuddy 插件 (onboarding + 对话内语音切换) ----------
# 仅在 smartbuddy agent (SMARTBUDDY_AGENT_ID 存在) 上启用. 插件默认 opt-in,
# 不在 plugins.enabled 里就不加载 -> platform_hint 与 TTS provider 都失效.
# 插件 id 用路径式 "platforms/smartbuddy" (与 `hermes plugins enable` 写入
# config 的形式一致); TTS provider 别名 "smartbuddy" (见插件 tts.py).
if os.environ.get("SMARTBUDDY_AGENT_ID"):
    plugins = data.setdefault("plugins", {})
    enabled = plugins.get("enabled")
    if not isinstance(enabled, list):
        enabled = []
        plugins["enabled"] = enabled
    if "platforms/smartbuddy" not in enabled:
        enabled.append("platforms/smartbuddy")
        dirty = True
    tts = data.setdefault("tts", {})
    if tts.get("provider") != "smartbuddy":
        tts["provider"] = "smartbuddy"
        dirty = True

    # ---------- 4) cron delivery for end users ----------
    # Drop the operator-style "Cronjob Response / job_id" wrapper and use
    # friendly failure notices (notify once, auto-pause; see cron/scheduler.py).
    cron = data.setdefault("cron", {})
    if cron.get("wrap_response") is not False or cron.get("friendly_failures") is not True:
        cron["wrap_response"] = False
        cron["friendly_failures"] = True
        dirty = True

    # ---------- 4b) chat display for end users ----------
    # No operator notices in the chat: memory updates / skill patches from the
    # background review are silent; only a NEWLY created skill is announced,
    # in plain language (memory_notifications=new_skills). Also no "⚡ Interrupting current task
    # (iteration n/90)…" (the app shows its own typing indicator). A follow-up
    # sent while busy steers the running task instead of aborting it — the
    # app's Stop button is the explicit way to interrupt.
    display = data.setdefault("display", {})
    wanted = {"memory_notifications": "new_skills", "busy_ack_enabled": False, "busy_input_mode": "steer"}
    if any(display.get(k) != v for k, v in wanted.items()):
        display.update(wanted)
        dirty = True
    # One "still working" notice per task, at 3 minutes (the plugin drops the
    # repeats — it can't edit messages, so each would be a new push).
    agent_cfg = data.setdefault("agent", {})
    if agent_cfg.get("gateway_notify_interval") != 180:
        agent_cfg["gateway_notify_interval"] = 180
        dirty = True

    # ---------- 4c) no double confirm for /new ----------
    # The app's "New chat" already asks "Start a new chat?" before sending
    # /new; hermes asking again ("⚠️ Confirm /new … reply /approve") is
    # redundant. The app doesn't expose /reset, /undo or /clear.
    approvals = data.setdefault("approvals", {})
    if approvals.get("destructive_slash_confirm") is not False:
        approvals["destructive_slash_confirm"] = False
        dirty = True

    # ---------- 4d) outbound actions always ask ----------
    # "Every action needs your approval": email, messages to other people and
    # writes to external services always prompt the user (never smart-
    # approved); cron jobs never send — they deliver a draft instead.
    if approvals.get("outbound_confirm") is not True:
        approvals["outbound_confirm"] = True
        dirty = True

    # ---------- 4e) mail only through the SmartBuddy connector ----------
    # himalaya / google-workspace keep mail passwords or Google tokens inside
    # the pod and would compete with the plugin's smartbuddy-mail skill
    # (password stays in the console). Keep anything else already disabled.
    skills = data.setdefault("skills", {})
    disabled = skills.get("disabled") or []
    if isinstance(disabled, str):
        disabled = [disabled]
    missing = [n for n in ("himalaya", "google-workspace") if n not in disabled]
    if missing:
        skills["disabled"] = list(disabled) + missing
        dirty = True

    # ---------- 4f) a fresh session every day, a lighter review ----------
    # One session ran for days: every model call carried 60-140k tokens and
    # replies waited ~45 s per compression. A new session at 4am local time
    # (TZ is the user's), no notice; memory, skills, errands and cron stay.
    # Compression keeps the last 10 messages (default 20, full of tool output).
    # The skill review fork replays the whole session; run it after 30 tool
    # steps instead of 10 (memory review unchanged).
    wanted_reset = {"mode": "daily", "at_hour": 4, "notify": False}
    reset = data.get("session_reset")
    if not isinstance(reset, dict) or any(reset.get(k) != v for k, v in wanted_reset.items()):
        data["session_reset"] = {**(reset if isinstance(reset, dict) else {}), **wanted_reset}
        dirty = True
    compression = data.get("compression")
    if not isinstance(compression, dict):
        compression = data["compression"] = {}
    if compression.get("protect_last_n") != 10:
        compression["protect_last_n"] = 10
        dirty = True
    if skills.get("creation_nudge_interval") != 30:
        skills["creation_nudge_interval"] = 30
        dirty = True

# ---------- 5) realign cron jobs' model snapshot ----------
# create_job() snapshots the default model; when the platform switches models
# (HERMES_DEFAULT_MODEL), unpinned jobs then hit the drift guard and are
# skipped forever (2026-10: qwen-plus -> deepseek-flash broke reminders).
# On SaaS pods the platform owns the model, so follow it. Runs before the
# scheduler starts, so no lock contention.
if litellm_url:
    jobs_path = cfg_path.parent / "cron" / "jobs.json"
    if jobs_path.exists():
        import json
        store = json.loads(jobs_path.read_text())
        jobs = store.get("jobs", []) if isinstance(store, dict) else store
        realigned = 0
        for job in jobs:
            snapshot = job.get("model_snapshot")
            if snapshot and not (job.get("model") or "").strip() and snapshot != default_model:
                job["model_snapshot"] = default_model
                realigned += 1
        if realigned:
            jobs_path.write_text(json.dumps(store, indent=2, ensure_ascii=False))
            print(f"[025-kiwiagent] cron: realigned {realigned} job(s) to model={default_model}")

if not dirty:
    sys.exit(0)

cfg_path.write_text(yaml.safe_dump(data, sort_keys=False))
tag = api_key[-6:] if api_key else "-"
print(f"[025-kiwiagent] config patched (api_server key tail=***{tag}, model={data.get('model',{}).get('default','?')}, plugins={data.get('plugins',{}).get('enabled',[])}, tts={data.get('tts',{}).get('provider','-')}, cron={data.get('cron',{})})")
PY
